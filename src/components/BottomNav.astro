---
import { site } from "../data/site";
import { telHref } from "../utils/links";
import Icon from "./Icon.astro";

const items = [
  { href: "/", label: "خانه", icon: "home" },
  { href: "/services/", label: "خدمات", icon: "grid" },
  { href: "/therapists/", label: "درمانگران", icon: "group" },
  { href: "/workshops/", label: "کارگاه‌ها", icon: "workshop" },
] as const;

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? current === "/" : current.startsWith(href);

const primaryPhone = site.phones[0];
---
<nav
  aria-label="ناوبری سریع موبایل"
  class="fixed inset-x-0 bottom-0 z-30 border-t border-primary-100 bg-surface/95 pb-[env(safe-area-inset-bottom)] backdrop-blur lg:hidden"
>
  <ul class="grid grid-cols-5">
    {items.map((item) => (
      <li>
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class:list={[
            "relative mx-1 my-2 flex h-12 flex-col items-center justify-center gap-0.5 rounded-xl text-[11px] leading-none transition-colors",
            isActive(item.href)
              ? "bg-primary-100 font-extrabold text-primary-800"
              : "font-medium text-ink-muted hover:bg-primary-50 hover:text-primary-700",
          ]}
        >
          {isActive(item.href) && (
            <span
              class="absolute inset-x-2 top-0 h-1 rounded-full bg-clay"
              aria-hidden="true"
            />
          )}
          <Icon name={item.icon} size={22} class={isActive(item.href) ? "text-primary-700" : undefined} />
          <span class={isActive(item.href) ? "text-primary-800" : undefined}>{item.label}</span>
        </a>
      </li>
    ))}
    <li>
      <a
        href={telHref(primaryPhone.number)}
        class="flex h-16 flex-col items-center justify-center gap-1 text-[11px] leading-none text-primary-700"
      >
        <span class="grid size-9 place-items-center rounded-full bg-primary-600 text-white">
          <Icon name="phone" size={19} />
        </span>
        <span class="font-bold">تماس</span>
      </a>
    </li>
  </ul>
</nav>
