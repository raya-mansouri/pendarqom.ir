---
import { site } from "../data/site";
import { telHref, whatsappLink } from "../utils/links";
import Icon from "./Icon.astro";

interface Props {
  compact?: boolean;
  stacked?: boolean;
}
const { compact = false, stacked = false } = Astro.props;

const primaryPhone = site.phones[0];
const isHttpUrl = (url?: string): url is string => !!url && /^https?:\/\/[^\s[\]]+$/.test(url);
const socials = [
  site.whatsapp && { label: "واتساپ", href: whatsappLink(site.whatsapp), icon: "whatsapp" },
  isHttpUrl(site.telegram) && { label: "تلگرام", href: site.telegram, icon: "telegram" },
  isHttpUrl(site.instagram) && { label: "اینستاگرام", href: site.instagram, icon: "instagram" },
  isHttpUrl(site.eitea) && { label: "ایتا", href: site.eitea, icon: "eitaa" },
  isHttpUrl(site.bale) && { label: "بله", href: site.bale, icon: "bale" },
].filter(Boolean) as { label: string; href: string; icon: string }[];
---
<div class:list={["flex gap-3", stacked ? "flex-col items-start" : "flex-wrap items-center"]}>
  <a href={telHref(primaryPhone.number)} class:list={["btn btn-call", compact && "px-3.5 py-2 text-xs"]}>
    <Icon name="phone" size={compact ? 16 : 18} />
    {primaryPhone.label}
  </a>
  {socials.length > 0 && (
    <ul class="flex flex-wrap items-center gap-2">
      {socials.map((s) => (
        <li>
          <a
            href={s.href}
            target="_blank"
            rel="noopener"
            aria-label={s.label}
            title={s.label}
            class:list={[
              "flex items-center justify-center rounded-full border border-primary-100 bg-surface transition-colors hover:border-primary-300 hover:bg-primary-50",
              compact ? "size-9" : "size-10",
            ]}
          >
            <Icon name={s.icon} size={compact ? 18 : 20} />
          </a>
        </li>
      ))}
    </ul>
  )}
</div>
