---
import { site } from "../data/site";
import ContactChannels from "./ContactChannels.astro";
import HoursTable from "./HoursTable.astro";
import MapCard from "./MapCard.astro";
---
<section class="section bg-primary-600 text-white" aria-label="رزرو نوبت">
  <div class="container-site grid items-stretch gap-6 sm:gap-8 lg:grid-cols-[1.2fr_0.85fr_1fr]">
    <div class="lg:self-center">
      <h2 class="text-3xl">قدم اول را بردارید</h2>
      <p class="mt-3 text-primary-100">
        جهت رزرو نوبت یا هر پرسش دیگری، از هر مسیر ارتباطی که برای تان راحت‌تر است تماس بگیرید. پاسخگویی و گفتگو کاملاً محرمانه است.
      </p>
      <div class="mt-6">
        <ContactChannels />
      </div>
    </div>
    <div class="flex flex-col justify-center rounded-2xl bg-white/10 p-5">
      <HoursTable title="ساعت کاری کلینیک" variant="on-dark" />
      <p class="mt-4 text-sm leading-6 text-primary-100">{site.address}</p>
    </div>
    <MapCard onDark class="h-full min-h-64" />
  </div>
</section>
