---
import { site } from "../data/site";
import { telHref } from "../utils/links";
import ContactChannels from "./ContactChannels.astro";
import HoursTable from "./HoursTable.astro";
import Icon from "./Icon.astro";
import MapCard from "./MapCard.astro";

const primaryPhone = site.phones[0];
---
<section class="section bg-primary-600 text-white" aria-label="رزرو نوبت">
  <div class="container-site grid items-stretch gap-6 sm:gap-8 lg:grid-cols-[1.2fr_0.85fr_1fr]">
    <div class="lg:self-center">
      <h2 class="text-3xl">قدم اول را بردارید</h2>
      <p class="mt-3 text-balance text-primary-50">
        جهت رزرو نوبت یا هر پرسش دیگری، از هر مسیر ارتباطی که برای تان راحت‌تر است تماس بگیرید. پاسخگویی و گفتگو کاملاً محرمانه است.
      </p>
      <div class="mt-5 flex gap-2.5">
        <a href="/contact/#booking" class="btn btn-secondary flex-1 whitespace-nowrap px-3.5 text-sm sm:flex-none">رزرو نوبت آنلاین</a>
        <a
          href={telHref(primaryPhone.number)}
          class="btn flex-1 gap-1.5 whitespace-nowrap border border-white/40 px-3.5 text-sm text-white hover:bg-white/10 sm:flex-none"
        >
          <Icon name="phone" size={16} />
          تماس تلفنی
        </a>
      </div>
      <div class="mt-6">
        <ContactChannels showCall={false} />
      </div>
    </div>
    <div class="flex flex-col justify-center rounded-2xl bg-white/10 p-5">
      <HoursTable title="ساعت کاری کلینیک" variant="on-dark" />
      <p class="mt-4 text-sm leading-6 text-primary-50">{site.address}</p>
    </div>
    <MapCard onDark class="h-full min-h-64" />
  </div>
</section>
