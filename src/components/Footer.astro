---
import { Picture } from "astro:assets";
import { site } from "../data/site";
import { telHref, whatsappLink } from "../utils/links";
import { toPersianDigits } from "../utils/persian";
import CrisisStrip from "./CrisisStrip.astro";
import Icon from "./Icon.astro";
import logo from "../assets/logo.png";

const year = new Intl.DateTimeFormat("fa-IR", { year: "numeric" }).format(new Date());

const isHttpUrl = (url?: string): url is string => !!url && /^https?:\/\/[^\s[\]]+$/.test(url);
const socials = [
  site.whatsapp ? { label: "واتساپ", href: whatsappLink(site.whatsapp), icon: "whatsapp" } : null,
  isHttpUrl(site.telegram) ? { label: "تلگرام", href: site.telegram, icon: "telegram" } : null,
  isHttpUrl(site.instagram) ? { label: "اینستاگرام", href: site.instagram, icon: "instagram" } : null,
  isHttpUrl(site.eitea) ? { label: "ایتا", href: site.eitea, icon: "eitaa" } : null,
  isHttpUrl(site.bale) ? { label: "بله", href: site.bale, icon: "bale" } : null,
].filter((s): s is { label: string; href: string; icon: string } => s !== null);
---
<footer class="mt-auto border-t border-primary-100 bg-surface">
  <div class="container-site grid gap-x-8 gap-y-8 py-10 sm:grid-cols-2 sm:gap-y-10 sm:py-14 lg:grid-cols-[1.75fr_1.1fr_1fr]">
    <section aria-label="درباره کلینیک" class="text-center sm:col-span-2 sm:text-start lg:col-span-1">
      <Picture
        src={logo}
        formats={["avif", "webp"]}
        densities={[1, 2, 3]}
        alt=""
        width={56}
        height={56}
        class="mx-auto size-14 sm:mx-0"
      />
      <p class="mt-3 text-base font-extrabold text-primary-700">{site.name}</p>
      <p class="mt-2 text-sm leading-7 text-ink-muted">{site.tagline}</p>
      <ul class="mt-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-xs text-ink-muted sm:justify-start">
        <li>از سال {toPersianDigits(site.foundedYear)}</li>
        <li>حضوری، تلفنی و آنلاین</li>
      </ul>
    </section>

    <section aria-label="تماس" class="border-t border-primary-100/80 pt-8 text-center sm:border-0 sm:pt-0 sm:text-start">
      <h2 class="mb-3 text-sm font-bold text-ink">تماس با ما</h2>
      <ul class="space-y-1.5 text-sm leading-7 text-ink-muted">
        {site.phones.map((p) => (
          <li><a class="hover:text-primary-700" href={telHref(p.number)}><bdi>{toPersianDigits(p.number)}</bdi></a></li>
        ))}
      </ul>

      {socials.length > 0 && (
        <ul class="mt-3 flex flex-wrap items-center justify-center gap-2 sm:justify-start">
          {socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                aria-label={s.label}
                title={s.label}
                class="flex size-10 items-center justify-center rounded-full border border-primary-100 bg-surface transition-colors hover:border-primary-300 hover:bg-primary-50"
              >
                <Icon name={s.icon} size={20} />
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>

    <div class="space-y-7 border-t border-primary-100/80 pt-8 text-center sm:border-0 sm:pt-0 sm:text-start">
      <section aria-label="ساعت کاری">
        <h2 class="mb-3 text-sm font-bold text-ink">ساعت کاری</h2>
        <ul class="mx-auto grid w-fit grid-cols-[auto_auto] gap-x-6 gap-y-1.5 text-sm text-ink-muted sm:mx-0 sm:flex sm:w-full sm:flex-col sm:gap-1.5">
          {site.hours.map((h) => (
            <li class="contents sm:flex sm:items-baseline sm:justify-between sm:gap-3">
              <span>{h.days}</span>
              <span class="font-medium text-ink">{h.time}</span>
            </li>
          ))}
        </ul>
      </section>

      <section aria-label="نشانی">
        <h2 class="mb-3 text-sm font-bold text-ink">نشانی</h2>
        <p class="text-sm leading-7 text-ink-muted">{site.address}</p>
        <div class="mt-3 flex flex-wrap justify-center gap-2 sm:justify-start">
          <a
            class="inline-flex items-center gap-1.5 rounded-full border border-primary-100 bg-surface px-3 py-1.5 text-xs text-ink-muted transition-colors hover:border-primary-300 hover:bg-primary-50 hover:text-primary-700"
            href={site.maps.neshan}
            target="_blank"
            rel="noopener"
          >
            <Icon name="neshan" size={16} />
            <span>مسیر در نشان</span>
          </a>
          <a
            class="inline-flex items-center gap-1.5 rounded-full border border-primary-100 bg-surface px-3 py-1.5 text-xs text-ink-muted transition-colors hover:border-primary-300 hover:bg-primary-50 hover:text-primary-700"
            href={site.maps.balad}
            target="_blank"
            rel="noopener"
          >
            <Icon name="balad" size={16} />
            <span>مسیر در بلد</span>
          </a>
        </div>
      </section>
    </div>
  </div>

  <CrisisStrip />

  <div class="border-t border-primary-100 py-6">
    <p class="container-site text-center text-sm text-ink-muted">
      اگر نمی‌دانید از کجا شروع کنید، همین حالا تماس بگیرید؛ در اولین گفت‌وگو با هم راه را پیدا می‌کنیم.
    </p>
    <p class="container-site mt-2 text-center text-xs text-ink-muted">
      © {year} کلینیک علمی روانشناسی پندار نیم‌رخ — کلیه حقوق محفوظ است.
    </p>
  </div>
</footer>
