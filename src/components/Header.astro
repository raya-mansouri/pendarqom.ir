---
import { Picture } from "astro:assets";
import { site } from "../data/site";
import { telHref } from "../utils/links";
import logo from "../assets/logo.png";

const nav = [
  { href: "/", label: "خانه" },
  { href: "/services/", label: "خدمات" },
  { href: "/therapists/", label: "درمانگران" },
  { href: "/workshops/", label: "کارگاه‌ها" },
  { href: "/articles/", label: "مقالات" },
  { href: "/about/", label: "درباره ما" },
  { href: "/contact/", label: "تماس با پندار" },
];
const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? current === "/" : current.startsWith(href);
const primaryPhone = site.phones[0];
---
<header class="sticky top-0 z-40 border-b border-primary-100 bg-bg/90 backdrop-blur">
  <div class="container-site flex h-16 items-center justify-between gap-4">
    <a href="/" aria-label={site.name} class="flex items-center gap-2.5 text-lg font-extrabold text-primary-700">
      <Picture
        src={logo}
        formats={["avif", "webp"]}
        densities={[1, 2, 3]}
        alt=""
        width={48}
        height={48}
        loading="eager"
        class="size-12"
      />
      <span class="whitespace-nowrap">{site.brandName}</span>
    </a>

    <nav aria-label="ناوبری اصلی" class="hidden items-center gap-1 lg:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class:list={[
            "rounded-lg px-3 py-2 text-sm font-medium transition-colors",
            isActive(item.href) ? "bg-primary-100 text-primary-800" : "text-ink-muted hover:bg-primary-50 hover:text-primary-700",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href="/contact/#booking" class="btn btn-primary hidden sm:inline-flex">رزرو نوبت</a>
      <a href={telHref(primaryPhone.number)} class="btn btn-secondary hidden xl:inline-flex">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233a14 14 0 0 0 6.392 6.384"/></svg>
        تماس
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="btn btn-secondary lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">باز کردن منو</span>
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  inert
  class="fixed inset-y-0 start-0 z-50 flex w-72 max-w-[85vw] translate-x-full flex-col overflow-y-auto bg-surface p-6 shadow-soft transition-transform duration-300 lg:hidden"
>
  <div class="mb-6 flex items-center justify-between">
    <span class="flex items-center gap-2.5">
      <Picture
        src={logo}
        formats={["avif", "webp"]}
        densities={[1, 2, 3]}
        alt=""
        width={40}
        height={40}
        class="size-10"
      />
      <span class="flex flex-col text-lg font-extrabold leading-tight text-primary-700">
        {site.brandName}
        <span class="text-xs font-medium text-ink-muted">کلینیک علمی روانشناسی</span>
      </span>
    </span>
    <button id="menu-close" type="button" class="btn btn-ghost px-2 py-1" >
      <span class="sr-only">بستن منو</span>
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  <nav aria-label="ناوبری موبایل" class="flex flex-col gap-1">
    {nav.map((item) => (
      <a
        href={item.href}
        aria-current={isActive(item.href) ? "page" : undefined}
        class:list={[
          "rounded-lg px-3 py-2.5 text-base font-medium",
          isActive(item.href) ? "bg-primary-100 text-primary-800" : "text-ink hover:bg-primary-50",
        ]}
      >
        {item.label}
      </a>
    ))}
    <a
      href="/faq/"
      aria-current={isActive("/faq/") ? "page" : undefined}
      class:list={[
        "rounded-lg px-3 py-2.5 text-base font-medium",
        isActive("/faq/") ? "bg-primary-100 text-primary-800" : "text-ink hover:bg-primary-50",
      ]}
    >
      سؤالات متداول
    </a>
    <a href="/contact/#booking" class="btn btn-primary mt-4">رزرو نوبت</a>
    <a href={telHref(primaryPhone.number)} class="btn btn-secondary mt-2">تماس تلفنی</a>
  </nav>
</div>
<div id="menu-backdrop" class="fixed inset-0 z-40 hidden bg-ink/40 lg:hidden"></div>
