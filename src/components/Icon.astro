---
import { iconPaths } from "./icons";
interface Props {
  name: keyof typeof iconPaths;
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;
---
<svg
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  set:html={`<path d="${iconPaths[name]}" />`}
/>
