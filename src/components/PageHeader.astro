---
import { Picture } from "astro:assets";
import Breadcrumbs from "./Breadcrumbs.astro";
import logo from "../assets/logo.png";

interface Props {
  title: string;
  breadcrumbs: { label: string; href?: string }[];
  intro?: string;
}

const { title, breadcrumbs, intro } = Astro.props;
const hasMeta = Astro.slots.has("meta");
---
<div class="container-site pt-10">
  <Breadcrumbs items={breadcrumbs} />
  <div class="mt-6 grid max-w-3xl grid-cols-[auto_minmax(0,1fr)] items-start gap-x-3 gap-y-3 sm:gap-x-5 sm:gap-y-4">
    <Picture
      src={logo}
      formats={["avif", "webp"]}
      densities={[1, 2, 3]}
      alt="لوگوی کلینیک پندار نیم‌رخ"
      width={96}
      height={96}
      class="size-14 shrink-0 sm:size-24"
      pictureAttributes={{ class: "shrink-0 self-start" }}
    />
    <div class="min-w-0">
      <slot name="meta" />
      <h1 class:list={["text-2xl sm:text-4xl", hasMeta && "mt-3"]}>{title}</h1>
      {intro && <p class="mt-3 text-base leading-7 text-ink-muted sm:text-lg sm:leading-8">{intro}</p>}
      <slot />
    </div>
  </div>
</div>
