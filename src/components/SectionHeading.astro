---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  id?: string;
}
const { eyebrow, title, lead, id } = Astro.props;
---
<div class="mx-auto mb-10 max-w-2xl text-center">
  {eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
  <h2 id={id} class="text-3xl sm:text-4xl">{title}</h2>
  {lead && <p class="mt-3 text-ink-muted">{lead}</p>}
</div>
