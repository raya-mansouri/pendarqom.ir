---
import { Picture } from "astro:assets";
import Icon from "../Icon.astro";
import { articleCovers } from "../../utils/assets";
import { toPersianDigits } from "../../utils/persian";

interface Props {
  id: string;
  title: string;
  description: string;
  dateDisplay: string;
  category: string;
  readingTime: number;
  headingLevel?: "h2" | "h3";
}
const { id, title, description, dateDisplay, category, readingTime, headingLevel: H = "h3" } = Astro.props;
const cover = articleCovers[id];
---
<a href={`/articles/${id}/`} class="card reveal group overflow-hidden transition-transform hover:-translate-y-1">
  {cover ? (
    <Picture
      src={cover}
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={[240, 360, 480, 720, 960, 1200]}
      sizes="(min-width: 64rem) 22rem, (min-width: 40rem) calc((100vw - 4.5rem) / 2), calc(100vw - 2rem)"
      quality={82}
      loading="lazy"
      decoding="async"
      alt={`تصویر شاخص مقاله «${title}»`}
      class="aspect-[1200/630] w-full object-cover"
    />
  ) : (
    <div class="aspect-[1200/630] w-full bg-gradient-to-bl from-primary-200 to-primary-50" aria-hidden="true"></div>
  )}
  <div class="p-5">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-muted">
      <span class="badge bg-primary-50 text-primary-700">{category}</span>
      <span class="whitespace-nowrap">{dateDisplay}</span>
      <span class="inline-flex items-center gap-1">
        <Icon name="clock" size={13} />
        {toPersianDigits(readingTime)} دقیقه مطالعه
      </span>
    </div>
    <H class="mt-2 font-bold leading-7 group-hover:text-primary-700 sm:min-h-14">{title}</H>
    <p class="mt-1 line-clamp-2 text-sm text-ink-muted">{description}</p>
  </div>
</a>
