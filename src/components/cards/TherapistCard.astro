---
import { Picture } from "astro:assets";
import { therapistPhotos } from "../../utils/assets";

interface Props {
  id: string;
  name: string;
  title: string;
  specialties: string[];
  issues?: string[];
  online?: boolean;
  headingLevel?: "h2" | "h3";
  sizes?: string;
  priority?: boolean;
}
const {
  id,
  name,
  title,
  specialties,
  issues = [],
  online = false,
  headingLevel: H = "h3",
  sizes = "(min-width: 72rem) 22rem, (min-width: 64rem) calc((100vw - 6rem) / 3), (min-width: 40rem) calc((100vw - 4.5rem) / 2), calc(100vw - 2rem)",
  priority = false,
} = Astro.props;
const photo = therapistPhotos[id];
---
<a
  href={`/therapists/${id}/`}
  data-therapist-card
  data-issues={issues.join(" ")}
  class="card reveal group flex flex-col overflow-hidden transition-transform hover:-translate-y-1"
>
  {photo && (
    <Picture
      src={photo}
      alt={`تصویر ${name}`}
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={[160, 240, 320, 400, 600, 800, 1000].filter((w) => w < photo.width).concat(photo.width)}
      sizes={sizes}
      quality={82}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : undefined}
      decoding="async"
      class="aspect-square w-full object-cover"
    />
  )}
  <div class="flex flex-1 flex-col p-5">
    <H class="font-bold group-hover:text-primary-700">{name}</H>
    <p class="mt-0.5 text-sm text-ink-muted">{title}</p>
    <div class="mt-3 mb-4 flex flex-wrap gap-1.5">
      {specialties.slice(0, 3).map((s) => (
        <span class="badge bg-primary-50 text-primary-700">{s}</span>
      ))}
      {online && <span class="badge bg-primary-100 text-primary-800">آنلاین</span>}
    </div>
    <p class="mt-auto flex items-center justify-between border-t border-primary-100 pt-3 text-sm font-semibold text-primary-700">
      مشاهده پروفایل
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:-translate-x-1"><path d="M15 6l-6 6 6 6"/></svg>
    </p>
  </div>
</a>
