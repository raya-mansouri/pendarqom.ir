---
import { Picture } from "astro:assets";
import { workshopPosters } from "../../utils/assets";
import { toPersianDigits } from "../../utils/persian";
import Icon from "../Icon.astro";
import StatusBadge from "../StatusBadge.astro";

interface Props {
  id: string;
  href: string;
  title: string;
  instructor: string;
  dateDisplay?: string;
  sessions?: number;
  status: "open" | "full" | "past";
  sizes?: string;
}
const {
  id,
  href,
  title,
  instructor,
  dateDisplay,
  sessions,
  status,
  sizes = "(min-width: 72rem) 22rem, (min-width: 64rem) calc((100vw - 6rem) / 3), (min-width: 48rem) calc((100vw - 4.5rem) / 2), (min-width: 40rem) calc(100vw - 3rem), calc(100vw - 2rem)",
} = Astro.props;
const poster = workshopPosters[id];
---
<a href={href} class:list={["card reveal group block overflow-hidden transition-transform hover:-translate-y-1", status === "past" && "opacity-75"]}>
  {poster && (
    <Picture
      src={poster}
      alt={`پوستر کارگاه ${title}`}
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={[240, 360, 480, 680, 820, 960, 1024].filter((w) => w < poster.width).concat(poster.width)}
      sizes={sizes}
      quality={82}
      loading="lazy"
      decoding="async"
      class="aspect-[3/4] w-full bg-surface object-contain"
    />
  )}
  <div class="p-5">
    <div class="flex items-center justify-between gap-3">
      <StatusBadge status={status} />
      {(dateDisplay || sessions) && (
        <span class="inline-flex items-center gap-1.5 text-xs text-ink-muted">
          <Icon name="calendar" size={14} />
          {dateDisplay ?? `${toPersianDigits(sessions ?? 0)} جلسه`}
        </span>
      )}
    </div>
    <h3 class="mt-3 text-lg font-bold group-hover:text-primary-700">{title}</h3>
    <p class="mt-1 text-sm text-ink-muted">مدرس: {instructor}</p>
  </div>
</a>
