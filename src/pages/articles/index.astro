---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ArticleCard from "../../components/cards/ArticleCard.astro";
import { readingTimeMinutes } from "../../utils/readingtime";

const articles = (await getCollection("articles"))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---
<BaseLayout
  title="مقالات | پندار نیم‌رخ"
  description="مقالات علمی و کاربردی درباره سلامت روان، روابط و فرزندپروری از کلینیک پندار نیم‌رخ."
>
  <PageHeader
    title="مقالات"
    breadcrumbs={[{ label: "خانه", href: "/" }, { label: "مقالات" }]}
    intro="خواندنی‌هایی برای آگاهی بیشتر درباره سلامت روان."
  />
  <section class="container-site section">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {articles.map((a) => (
        <ArticleCard
          id={a.id}
          title={a.data.title}
          description={a.data.description}
          dateDisplay={a.data.dateDisplay}
          category={a.data.category}
          readingTime={readingTimeMinutes(a.body ?? "")}
          headingLevel="h2"
        />
      ))}
    </div>
  </section>
</BaseLayout>
