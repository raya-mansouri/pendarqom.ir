---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import ContactChannels from "../components/ContactChannels.astro";
import HoursTable from "../components/HoursTable.astro";
import MapCard from "../components/MapCard.astro";
import BookingForm from "../components/BookingForm.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
import { telHref } from "../utils/links";
import { toPersianDigits } from "../utils/persian";

const primaryPhone = site.phones[0];
const telephone = "+98" + primaryPhone.number.replace(/\D/g, "").replace(/^0/, "");
const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const therapists = (await getCollection("therapists"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((t) => ({ slug: t.id, name: t.data.name }));
---
<BaseLayout
  title="تماس و رزرو نوبت | پندار نیم‌رخ"
  description="تماس با کلینیک علمی روانشناسی پندار نیم‌رخ: تلفن، واتساپ، نشانی و ساعت کاری."
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "Psychologist",
      name: site.name,
      url: site.url,
      telephone,
      address: { "@type": "PostalAddress", addressLocality: "قم", addressCountry: "IR", streetAddress: site.address },
      openingHours: ["Sa-Su 10:00-22:00", "Mo-Th 10:00-22:00"],
    },
  ]}
>
  <PageHeader
    title="تماس و رزرو نوبت"
    breadcrumbs={[{ label: "خانه", href: "/" }, { label: "تماس و رزرو نوبت" }]}
  >
    <p class="mt-3 text-lg leading-8 text-ink-muted">
      برای رزرو نوبت، پرسش درباره خدمات یا ثبت‌نام کارگاه‌ها از هر راهی که برای شما راحت‌تر است با ما در میان بگذارید.
    </p>
    <p class="mt-4 rounded-xl bg-navy-50 px-4 py-3 text-sm leading-6 text-navy">
      همه تماس‌ها و پیام‌ها کاملاً محرمانه بررسی می‌شوند. اطلاعات شما در اختیار هیچ شخص ثالثی قرار نمی‌گیرد.
    </p>
  </PageHeader>

  <section id="booking" class="container-site section mx-auto max-w-3xl scroll-mt-24">
    <h2 class="text-2xl sm:text-3xl">درخواست نوبت</h2>
    <p class="mt-2 text-ink-muted">
      فرم را پر کنید؛ پیام آماده در واتساپ باز می‌شود و کلینیک در ساعت کاری پاسخ می‌دهد.
    </p>
    <div class="card mt-6 p-5 sm:p-6">
      <BookingForm services={services.map((s) => ({ title: s.data.title }))} therapists={therapists} />
    </div>
    <p class="mt-4 text-sm leading-7 text-ink-muted">
      پاسخ پرسش‌های رایج درباره رزرو نوبت، هزینه جلسات و رازداری را در
      <a href="/faq/" class="font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"> سؤالات متداول </a>
      بخوانید.
    </p>
  </section>

  <section class="container-site section mx-auto grid max-w-6xl gap-8 lg:grid-cols-3">
    <div class="card p-5">
      <h2 class="text-lg font-bold">راه‌های ارتباطی</h2>
      <div class="mt-4">
        <ContactChannels stacked />
      </div>
      <div class="mt-6 space-y-3 text-sm">
        {site.phones.map((p) => (
          <p class="flex items-center gap-2 text-ink-muted">
            <span class="text-primary-600"><Icon name="phone" size={16} /></span>
            <span>{p.label}:</span>
            <a class="font-semibold text-ink hover:text-primary-700" href={telHref(p.number)}><bdi>{toPersianDigits(p.number)}</bdi></a>
          </p>
        ))}
      </div>
    </div>

    <MapCard zoom={17} class="h-full min-h-64" />

    <div class="card p-5">
      <div class="mt-4">
        <HoursTable title="ساعت کاری" dividers={false} />
      </div>

      <div class="mt-6">
        <h2 class="text-lg font-bold">نشانی</h2>
        <p class="mt-3 flex items-start gap-2 text-sm text-ink-muted">
          <span class="mt-0.5 text-primary-600"><Icon name="map" size={16} /></span>
          <span>{site.address}</span>
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          <a class="btn btn-secondary px-3.5 py-2 text-xs" href={site.maps.neshan} target="_blank" rel="noopener">
            <Icon name="neshan" size={16} /> نمایش در نشان
          </a>
          <a class="btn btn-secondary px-3.5 py-2 text-xs" href={site.maps.balad} target="_blank" rel="noopener">
            <Icon name="balad" size={16} /> نمایش در بلد
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
