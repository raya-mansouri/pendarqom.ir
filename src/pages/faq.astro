---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";
import { faqs } from "../data/faq";

const ordered = [...faqs].sort((a, b) => a.order - b.order);
---
<BaseLayout
  title="سؤالات متداول | پندار نیم‌رخ"
  description="پاسخ پرسش‌های رایج درباره رزرو نوبت، هزینه، رازداری و جلسات کلینیک پندار نیم‌رخ."
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: ordered.map((f) => ({
        "@type": "Question",
        name: f.question,
        acceptedAnswer: { "@type": "Answer", text: f.answer },
      })),
    },
  ]}
>
  <PageHeader
    title="سؤالات متداول"
    breadcrumbs={[{ label: "خانه", href: "/" }, { label: "سؤالات متداول" }]}
    intro="پاسخ روشن پرسش‌هایی که پیش از اولین جلسه برای بیشتر مراجعین پیش می‌آید."
  />
  <section class="container-site section max-w-3xl">
    {ordered.map((f) => (
      <details name="faq" class="card group mb-3 p-5">
        <summary class="cursor-pointer list-none font-bold marker:hidden">
          <span class="flex items-center justify-between gap-4">
            {f.question}
            <span aria-hidden="true" class="text-primary-600 transition-transform group-open:rotate-45">
              <Icon name="plus" size={20} />
            </span>
          </span>
        </summary>
        <p class="mt-3 text-sm leading-7 text-ink-muted">{f.answer}</p>
      </details>
    ))}
    <p class="mt-6 text-center text-sm leading-7 text-ink-muted">
      پاسخ سؤال خود را پیدا نکردید؟
      <a href="/contact/" class="font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"> با کلینیک تماس بگیرید </a>
      یا
      <a href="/contact/#booking" class="font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"> درخواست نوبت </a>
      بدهید.
    </p>
  </section>
</BaseLayout>
