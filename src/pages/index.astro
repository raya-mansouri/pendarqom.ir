---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ServiceCard from "../components/cards/ServiceCard.astro";
import TherapistCard from "../components/cards/TherapistCard.astro";
import WorkshopCard from "../components/cards/WorkshopCard.astro";
import ArticleCard from "../components/cards/ArticleCard.astro";
import TestimonialCard from "../components/cards/TestimonialCard.astro";
import CtaStrip from "../components/CtaStrip.astro";
import { site } from "../data/site";
import { testimonials } from "../data/testimonials";
import { telHref } from "../utils/links";
import { toPersianDigits } from "../utils/persian";
import { readingTimeMinutes } from "../utils/readingtime";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const allTherapists = (await getCollection("therapists")).sort((a, b) => a.data.order - b.data.order);
const featuredTherapists = allTherapists.filter((t) => t.data.featured);
const therapists = (featuredTherapists.length > 0 ? featuredTherapists : allTherapists).slice(0, 4);
// کارگاه‌های بدون تاریخ شروع (تا اعلام تاریخ) در انتهای فهرست می‌مانند
const startOf = (w: { data: { startDate?: Date } }) => w.data.startDate?.valueOf() ?? Number.MAX_SAFE_INTEGER;
const workshops = (await getCollection("workshops"))
  .filter((w) => w.data.status !== "past")
  .sort((a, b) => startOf(a) - startOf(b))
  .slice(0, 3);
const articles = (await getCollection("articles"))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
const shownTestimonials = testimonials.filter((t) => t.consent && !t.placeholder).slice(0, 4);
const primaryPhone = site.phones[0];
const telephone = "+98" + primaryPhone.number.replace(/\D/g, "").replace(/^0/, "");

const whyUs = [
  { title: "درمانگران دارای پروانه", text: "همه درمانگران ما دارای پروانه فعالیت معتبر از سازمان نظام روانشناسی و مشاوره هستند." },
  { title: "رویکردهای مبتنی بر شواهد", text: "از درمان‌های علمی و اثبات‌شده مانند CBT استفاده می‌کنیم؛ نه ادعا، بلکه روش." },
  { title: "رازداری کامل", text: "همه گفت‌وگوها و اطلاعات شما محرمانه می‌ماند؛ امنیت روان شما اولویت ماست." },
  { title: "فضایی آرام و امن", text: "فضای کلینیک برای آرامش از همان لحظه ورود طراحی شده است." },
];
---
<BaseLayout
  title="کلینیک علمی روانشناسی پندار نیم‌رخ قم"
  description="کلینیک روانشناسی پندار نیم‌رخ در قم؛ روان‌درمانی فردی، زوج‌درمانی، مشاوره کودک و نوجوان، گروه‌درمانی و تست روانشناسی. حضوری، تلفنی و آنلاین."
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "Psychologist",
      name: site.name,
      url: site.url,
      telephone,
      address: { "@type": "PostalAddress", addressLocality: "قم", addressCountry: "IR", streetAddress: site.address },
      openingHours: ["Sa-Su 10:00-22:00", "Mo-Th 10:00-22:00"],
      image: new URL("/og-default.png", site.url).href,
    },
  ]}
>
  <!-- ۱. Hero -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-bl from-primary-50 via-bg to-primary-100" aria-hidden="true"></div>
    <div class="container-site relative grid gap-12 py-20 sm:py-28 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div>
        <h1 class="mt-3 text-3xl leading-[1.35] sm:text-5xl sm:leading-[1.25]">
          کلینیک علمی روانشناسی پندار نیم‌رخ قم
        </h1>
        <p class="mt-4 text-xl font-semibold text-ink sm:text-2xl">
          سلامت روان شما، <span class="text-primary-600">با روش علمی</span> و در فضایی آرام
        </p>
        <p class="mt-4 max-w-xl text-lg text-ink-muted">
          روان‌درمانی فردی، زوج‌درمانی، مشاوره کودک و نوجوان و ارزیابی روانشناختی؛ با درمانگران دارای پروانه، حضوری، تلفنی و آنلاین.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={telHref(primaryPhone.number)} class="btn btn-primary px-7 py-3 text-base">رزرو نوبت</a>
          <a href="/services/" class="btn btn-secondary px-7 py-3 text-base">خدمات کلینیک</a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-muted">
          <li class="flex items-center gap-1.5">پروانه {site.licenses[0].number}</li>
          <li class="flex items-center gap-1.5">از سال {toPersianDigits(site.foundedYear)}</li>
        </ul>
      </div>
      <div class="relative hidden lg:block" aria-hidden="true">
        <div class="absolute -inset-6 rounded-t-[13rem] rounded-b-[3rem] bg-primary-100"></div>
        <div class="relative grid size-full min-h-80 place-items-center rounded-t-[10rem] rounded-b-[2.5rem] bg-gradient-to-bl from-primary-200 to-primary-50 shadow-soft">
          <span class="text-8xl">🌿</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ۲. خدمات -->
  <section class="section bg-surface" aria-labelledby="services-title">
    <div class="container-site">
      <SectionHeading id="services-title" eyebrow="خدمات ما" title="خدمات تخصصی روانشناسی در قم" lead="از درمان فردی تا ارزیابی کودک — با روش‌های علمی و مبتنی بر شواهد" />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <ServiceCard
            title={s.data.title}
            summary={s.data.summary}
            category={s.data.category}
            icon={s.data.icon}
            href={`/services/${s.id}/`}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ۳. چرا ما -->
  <section class="section" aria-labelledby="why-title">
    <div class="container-site">
      <SectionHeading id="why-title" eyebrow="چرا پندار نیم‌رخ" title="اعتماد شما، مسئولیت ما" />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {whyUs.map((item) => (
          <div class="card reveal p-6">
            <h3 class="font-bold text-primary-700">{item.title}</h3>
            <p class="mt-2 text-sm leading-7 text-ink-muted">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ۴. درمانگران -->
  <section class="section bg-surface" aria-labelledby="team-title">
    <div class="container-site">
      <SectionHeading id="team-title" eyebrow="تیم ما" title="روانشناسان کلینیک پندار نیم‌رخ قم" lead="با متخصصان پندار آشنا شوید" />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {therapists.map((t) => (
          <TherapistCard
            id={t.id}
            name={t.data.name}
            title={t.data.title}
            specialties={t.data.specialties}
            sizes="(min-width: 72rem) 16.125rem, (min-width: 64rem) calc((100vw - 7.5rem) / 4), (min-width: 40rem) calc((100vw - 4.5rem) / 2), calc(100vw - 2rem)"
          />
        ))}
      </div>
      <p class="mt-8 text-center">
        <a href="/therapists/" class="btn btn-secondary">مشاهده همه درمانگران</a>
      </p>
    </div>
  </section>

  <!-- ۵. کارگاه‌ها -->
  <section class="section" aria-labelledby="workshops-title">
    <div class="container-site">
      <SectionHeading id="workshops-title" eyebrow="آموزش" title="کارگاه‌های پیشِ رو" lead="مهارت‌های روانی را در محیطی گروهی و کاربردی تمرین کنید" />
      <div class="grid gap-6 md:grid-cols-3">
        {workshops.map((w) => (
          <WorkshopCard
            id={w.id}
            href={`/workshops/${w.id}/`}
            title={w.data.title}
            instructor={w.data.instructor}
            dateDisplay={w.data.dateDisplay}
            sessions={w.data.sessions}
            status={w.data.status}
            sizes="(min-width: 72rem) 22rem, (min-width: 48rem) calc((100vw - 6rem) / 3), (min-width: 40rem) calc(100vw - 3rem), calc(100vw - 2rem)"
          />
        ))}
      </div>
      <p class="mt-8 text-center">
        <a href="/workshops/" class="btn btn-secondary">همه کارگاه‌ها</a>
      </p>
    </div>
  </section>

  <!-- ۶. نظرات مراجعین -->
  {shownTestimonials.length > 0 && (
    <section class="section bg-surface" aria-labelledby="testimonials-title">
      <div class="container-site">
        <SectionHeading id="testimonials-title" eyebrow="تجربه مراجعین" title="آنچه مراجعان ما می‌گویند" />
        <div class="grid gap-6 md:grid-cols-3">
          {shownTestimonials.map((t) => (
            <TestimonialCard quote={t.quote} attribution={t.attribution} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ۷. مقالات -->
  <section class="section" aria-labelledby="articles-title">
    <div class="container-site">
      <SectionHeading id="articles-title" eyebrow="خواندنی‌ها" title="آخرین مقالات" />
      <div class="grid gap-6 md:grid-cols-3">
        {articles.map((a) => (
          <ArticleCard
            id={a.id}
            title={a.data.title}
            description={a.data.description}
            dateDisplay={a.data.dateDisplay}
            category={a.data.category}
            readingTime={readingTimeMinutes(a.body ?? "")}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ۸. نوار تماس -->
  <CtaStrip />
</BaseLayout>
