---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ServiceCard from "../components/cards/ServiceCard.astro";
import TherapistCard from "../components/cards/TherapistCard.astro";
import WorkshopCard from "../components/cards/WorkshopCard.astro";
import ArticleCard from "../components/cards/ArticleCard.astro";
import TestimonialCard from "../components/cards/TestimonialCard.astro";
import CtaStrip from "../components/CtaStrip.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
import { testimonials } from "../data/testimonials";
import { telHref } from "../utils/links";
import { toPersianDigits } from "../utils/persian";
import { readingTimeMinutes } from "../utils/readingtime";
import logo from "../assets/logo.png";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const allTherapists = (await getCollection("therapists")).sort((a, b) => a.data.order - b.data.order);
const featuredTherapists = allTherapists.filter((t) => t.data.featured);
const therapists = (featuredTherapists.length > 0 ? featuredTherapists : allTherapists).slice(0, 4);
// کارگاه‌های بدون تاریخ شروع (تا اعلام تاریخ) در انتهای فهرست می‌مانند
const startOf = (w: { data: { startDate?: Date } }) => w.data.startDate?.valueOf() ?? Number.MAX_SAFE_INTEGER;
const workshops = (await getCollection("workshops"))
  .filter((w) => w.data.status !== "past")
  .sort((a, b) => startOf(a) - startOf(b))
  .slice(0, 3);
const articles = (await getCollection("articles"))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
const shownTestimonials = testimonials.filter((t) => t.consent && !t.placeholder).slice(0, 4);
const primaryPhone = site.phones[0];
const telephone = "+98" + primaryPhone.number.replace(/\D/g, "").replace(/^0/, "");

const whyUs = [
  { icon: "therapists", title: "شروع بدون تعهد", text: "لازم نیست از قبل تصمیم نهایی را بگیرید؛ جلسه اول برای آشنایی و شنیدن مسئله شماست و بعد با هم درباره ادامه تصمیم می‌گیرید." },
  { icon: "evidence", title: "رویکردهای مبتنی بر شواهد", text: "از درمان‌های علمی و اثبات‌شده مانند CBT استفاده می‌کنیم؛ نه ادعا، بلکه روش." },
  { icon: "privacy", title: "رازداری کامل", text: "همه گفت‌وگوها و اطلاعات شما محرمانه می‌ماند؛ امنیت روان شما اولویت ماست." },
  { icon: "calm", title: "فضایی آرام و امن", text: "فضای کلینیک برای آرامش از همان لحظه ورود طراحی شده است." },
];
---
<BaseLayout
  title="کلینیک علمی روانشناسی پندار نیم‌رخ قم"
  description="کلینیک روانشناسی پندار نیم‌رخ در قم؛ روان‌درمانی فردی، زوج‌درمانی، مشاوره کودک و نوجوان، گروه‌درمانی و تست روانشناسی. حضوری، تلفنی و آنلاین."
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "Psychologist",
      name: site.name,
      url: site.url,
      telephone,
      address: { "@type": "PostalAddress", addressLocality: "قم", addressCountry: "IR", streetAddress: site.address },
      openingHours: ["Sa-Su 10:00-22:00", "Mo-Th 10:00-22:00"],
      logo: new URL("/logo.png", site.url).href,
      image: new URL("/og-default.png", site.url).href,
    },
  ]}
>
  <!-- ۱. Hero -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-bl from-primary-50 via-bg to-primary-100" aria-hidden="true"></div>
    <div class="container-site relative grid gap-12 py-16 sm:py-24 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div class="@container">
        <p class="inline-flex items-center gap-2 rounded-full border border-primary-200 bg-surface/70 px-4 py-1.5 text-sm font-semibold text-primary-700">
          کلینیک روانشناسی در قم
        </p>
        <h1 class="mt-5 text-[min(30px,calc(100cqw/15.8))] leading-[1.35] sm:text-[min(48px,calc(100cqw/15.8))] sm:leading-[1.25] lg:text-[30px] lg:leading-[1.3] xl:text-[36px]">
          کلینیک علمی روانشناسی پندار نیم‌رخ قم
        </h1>
        <p class="mt-5 text-lg font-semibold text-ink sm:text-2xl">
          اینجا می‌توانید بدون قضاوت، از خودتان و رابطه‌تان حرف بزنید
        </p>
        <p class="mt-4 max-w-xl text-lg leading-8 text-ink-muted">
          روان‌درمانی فردی، زوج‌درمانی، مشاوره کودک و نوجوان و ارزیابی روانشناختی؛ حضوری، تلفنی و آنلاین.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={telHref(primaryPhone.number)} class="btn btn-primary px-7 py-3 text-base">رزرو نوبت</a>
          <a href="/services/" class="btn btn-secondary px-7 py-3 text-base">خدمات کلینیک</a>
        </div>
        <p class="mt-3 text-sm text-ink-muted">
          نمی‌دانید از کجا شروع کنید؟ کافی است تماس بگیرید؛ در اولین گفت‌وگو راهنمایی‌تان می‌کنیم.
        </p>
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-muted">
          <li class="flex items-center gap-1.5">از سال {toPersianDigits(site.foundedYear)}</li>
          <li class="flex items-center gap-1.5">حضوری، تلفنی و آنلاین</li>
        </ul>
      </div>
      <div class="relative hidden lg:block" aria-hidden="true">
        <div class="absolute -inset-6 rounded-t-[13rem] rounded-b-[3rem] bg-primary-100"></div>
        <div class="relative flex min-h-[24rem] flex-col items-center justify-center gap-8 rounded-t-[10rem] rounded-b-[2.5rem] bg-gradient-to-bl from-primary-200 via-primary-50 to-surface px-10 text-center shadow-soft">
          <div class="absolute inset-4 rounded-t-[9rem] rounded-b-[2rem] border border-surface/70"></div>
          <Picture
            src={logo}
            formats={["avif", "webp"]}
            densities={[1, 2]}
            alt=""
            width={160}
            height={160}
            loading="eager"
            class="relative w-40 drop-shadow-sm"
          />
          <p class="relative max-w-[15rem] text-base leading-8 text-primary-800">
            فضایی آرام و محرمانه، برای گفت‌وگویی صادقانه دربارهٔ آنچه برایتان مهم است.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ۲. خدمات -->
  <section class="section bg-surface" aria-labelledby="services-title">
    <div class="container-site">
      <SectionHeading id="services-title" eyebrow="خدمات ما" title="خدمات تخصصی روانشناسی در قم" lead="از درمان فردی تا ارزیابی کودک — با روش‌های علمی و مبتنی بر شواهد" />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <ServiceCard
            title={s.data.title}
            summary={s.data.summary}
            category={s.data.category}
            icon={s.data.icon}
            href={`/services/${s.id}/`}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ۳. درمانگران -->
  <section class="section" aria-labelledby="team-title">
    <div class="container-site">
      <SectionHeading id="team-title" eyebrow="تیم ما" title="روانشناسان کلینیک پندار نیم‌رخ قم" lead="با متخصصان پندار آشنا شوید" />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {therapists.map((t) => (
          <TherapistCard
            id={t.id}
            name={t.data.name}
            title={t.data.title}
            specialties={t.data.specialties}
            online={t.data.online}
            sizes="(min-width: 72rem) 16.125rem, (min-width: 64rem) calc((100vw - 7.5rem) / 4), (min-width: 40rem) calc((100vw - 4.5rem) / 2), calc(100vw - 2rem)"
          />
        ))}
      </div>
      <p class="mt-8 text-center">
        <a href="/therapists/" class="btn btn-secondary">مشاهده همه درمانگران</a>
      </p>
    </div>
  </section>

  <!-- ۴. چرا ما -->
  <section class="section bg-surface" aria-labelledby="why-title">
    <div class="container-site">
      <SectionHeading
        id="why-title"
        eyebrow="چرا پندار نیم‌رخ"
        title="اعتماد شما، مسئولیت ما"
        lead="پندار نیم‌رخ نماینده گروه سازمان‌های علمی، اجتماعی، درمانی پندار در قم است؛ از سال ۱۳۹۷ در کنار مراجعان قم، با همراهی درمانگران حرفه ای و تیمی متخصص ."
      />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {whyUs.map((item) => (
          <div class="card reveal p-6">
            <span class="grid size-11 place-items-center rounded-xl bg-primary-50 text-primary-600">
              <Icon name={item.icon} size={22} />
            </span>
            <h3 class="mt-4 font-bold text-primary-700">{item.title}</h3>
            <p class="mt-2 text-sm leading-7 text-ink-muted">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ۵. کارگاه‌ها -->
  <section class="section" aria-labelledby="workshops-title">
    <div class="container-site">
      <SectionHeading id="workshops-title" eyebrow="آموزش" title="کارگاه‌های پیشِ رو" lead="مهارت‌های روانی را در محیطی گروهی و کاربردی تمرین کنید" />
      <div class="grid gap-6 md:grid-cols-3">
        {workshops.map((w) => (
          <WorkshopCard
            id={w.id}
            href={`/workshops/${w.id}/`}
            title={w.data.title}
            instructor={w.data.instructor}
            dateDisplay={w.data.dateDisplay}
            sessions={w.data.sessions}
            status={w.data.status}
            sizes="(min-width: 72rem) 22rem, (min-width: 48rem) calc((100vw - 6rem) / 3), (min-width: 40rem) calc(100vw - 3rem), calc(100vw - 2rem)"
          />
        ))}
      </div>
      <p class="mt-8 text-center">
        <a href="/workshops/" class="btn btn-secondary">همه کارگاه‌ها</a>
      </p>
    </div>
  </section>

  <!-- ۶. نظرات مراجعین -->
  {shownTestimonials.length > 0 && (
    <section class="section bg-surface" aria-labelledby="testimonials-title">
      <div class="container-site">
        <SectionHeading id="testimonials-title" eyebrow="تجربه مراجعین" title="آنچه مراجعان پندار می‌گویند" />
        <div class="grid gap-6 md:grid-cols-3">
          {shownTestimonials.map((t) => (
            <TestimonialCard quote={t.quote} attribution={t.attribution} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ۷. نوار تماس -->
  <CtaStrip />

  <!-- ۸. مقالات -->
  <section class="section" aria-labelledby="articles-title">
    <div class="container-site">
      <SectionHeading id="articles-title" eyebrow="خواندنی‌ها" title="آخرین مقالات" />
      <div class="grid gap-6 md:grid-cols-3">
        {articles.map((a) => (
          <ArticleCard
            id={a.id}
            title={a.data.title}
            description={a.data.description}
            dateDisplay={a.data.dateDisplay}
            category={a.data.category}
            readingTime={readingTimeMinutes(a.body ?? "")}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
