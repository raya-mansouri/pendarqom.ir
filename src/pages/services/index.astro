---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ServiceCard from "../../components/cards/ServiceCard.astro";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="خدمات تخصصی روانشناسی کلینیک پندار نیم‌رخ قم"
  description="خدمات روانشناسی در قم؛ روان‌درمانی فردی، زوج‌درمانی، خانواده‌درمانی، مشاوره کودک و نوجوان، گروه‌درمانی و تست روانشناسی در کلینیک پندار نیم‌رخ."
>
  <PageHeader
    title="خدمات تخصصی روانشناسی در قم"
    breadcrumbs={[{ label: "خانه", href: "/" }, { label: "خدمات" }]}
    intro="هر خدمت صفحه اختصاصی دارد؛ برای آشنایی بیشتر روی هر کارت بزنید یا مستقیم برای نوبت تماس بگیرید."
  />
  <section class="container-site section">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <ServiceCard
          title={s.data.title}
          summary={s.data.summary}
          category={s.data.category}
          icon={s.data.icon}
          href={`/services/${s.id}/`}
          headingLevel="h2"
        />
      ))}
    </div>
    <p class="mt-10 text-center text-sm leading-7 text-ink-muted sm:text-base">
      نمی‌دانید کدام خدمت مناسب شماست؟ پاسخ پرسش‌های رایج درباره جلسه اول، هزینه و رازداری را در
      <a href="/faq/" class="font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800">سؤالات متداول</a>
      ببینید.
    </p>
  </section>
</BaseLayout>
