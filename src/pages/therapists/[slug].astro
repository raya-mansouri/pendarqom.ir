---
import { getCollection, render } from "astro:content";
import { Picture } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ContactChannels from "../../components/ContactChannels.astro";
import { site } from "../../data/site";
import { therapistPhotos } from "../../utils/assets";

export async function getStaticPaths() {
  const therapists = await getCollection("therapists");
  return therapists.map((therapist) => ({
    params: { slug: therapist.id },
    props: { therapist },
  }));
}
const { therapist } = Astro.props;
const { Content } = await render(therapist);
const photo = therapistPhotos[therapist.id];
---
<BaseLayout
  title={therapist.data.seoTitle ?? `${therapist.data.name} | پندار نیم‌رخ`}
  description={therapist.data.seoDescription ?? `${therapist.data.name} — ${therapist.data.title} در کلینیک علمی روانشناسی پندار نیم‌رخ`}
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "Person",
      name: therapist.data.name,
      jobTitle: therapist.data.title,
      worksFor: { "@type": "Psychologist", name: site.name, url: site.url },
      image: photo ? new URL(photo.src, site.url).href : undefined,
      knowsAbout: therapist.data.specialties,
      sameAs: therapist.data.registryUrl ? [therapist.data.registryUrl] : undefined,
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "خانه", item: site.url },
        { "@type": "ListItem", position: 2, name: "درمانگران", item: `${site.url}/therapists/` },
        { "@type": "ListItem", position: 3, name: therapist.data.name },
      ],
    },
  ]}
>
  <div class="container-site pt-10">
    <Breadcrumbs items={[{ label: "خانه", href: "/" }, { label: "درمانگران", href: "/therapists/" }, { label: therapist.data.name }]} />
  </div>
  <section class="container-site section grid grid-cols-[auto_minmax(0,1fr)] items-start gap-x-4 gap-y-6 lg:grid-cols-[320px_1fr] lg:gap-x-10">
    <div class="lg:col-start-1 lg:row-span-2">
      {photo && (
        <Picture
          src={photo}
          alt={`تصویر ${therapist.data.name}`}
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[96, 112, 160, 200, 320, 480, 640, 820, 1000, 1200].filter((w) => w < photo.width).concat(photo.width)}
          sizes="(min-width: 64rem) 320px, 112px"
          quality={82}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="card aspect-square size-24 shrink-0 object-cover sm:size-28 lg:size-auto lg:w-full"
        />
      )}
    </div>
    <header class="min-w-0 lg:col-start-2 lg:row-start-1">
      <h1 class="text-2xl sm:text-4xl">{therapist.data.name}</h1>
      <p class="mt-2 text-base text-ink-muted sm:text-lg">{therapist.data.title} در قم</p>
      <p class="mt-1 text-xs text-ink-muted sm:text-sm">{therapist.data.licenseNumber}</p>
      {therapist.data.registryUrl && (
        <p class="mt-1.5 text-xs text-ink-muted sm:text-sm">
          <a
            href={therapist.data.registryUrl}
            target="_blank"
            rel="noopener"
            class="underline underline-offset-4 decoration-primary-300 hover:text-primary-700"
          >
            استعلام پروانه در سامانه سازمان نظام روانشناسی
          </a>
          <span class="text-xs"> · آخرین استعلام: آبان ۱۴۰۵</span>
        </p>
      )}
    </header>
    <div class="col-span-2 lg:col-span-1 lg:col-start-2 lg:row-start-2">
      <dl class="grid gap-4 sm:grid-cols-2">
        <div class="card p-4">
          <dt class="text-sm font-bold text-primary-700">حوزه‌های تخصصی</dt>
          <dd class="mt-2 flex flex-wrap gap-1.5">
            {therapist.data.specialties.map((s) => <span class="badge bg-primary-50 text-primary-700">{s}</span>)}
          </dd>
        </div>
        {therapist.data.approaches.length > 0 && (
          <div class="card p-4">
            <dt class="text-sm font-bold text-primary-700">رویکردهای درمانی</dt>
            <dd class="mt-2 flex flex-wrap gap-1.5">
              {therapist.data.approaches.map((a) => <span class="badge bg-primary-50 text-primary-700">{a}</span>)}
            </dd>
          </div>
        )}
        {therapist.data.education.length > 0 && (
          <div class="card p-4">
            <dt class="text-sm font-bold text-primary-700">تحصیلات و گواهی‌ها</dt>
            <dd class="mt-2">
              <ul class="list-disc space-y-1 ps-5 text-sm text-ink-muted">
                {therapist.data.education.map((e) => <li>{e}</li>)}
              </ul>
            </dd>
          </div>
        )}
        <div class="card p-4">
          <dt class="text-sm font-bold text-primary-700">زبان‌ها</dt>
          <dd class="mt-2 text-sm text-ink-muted">{therapist.data.languages.join("، ")}</dd>
        </div>
      </dl>

      <div class="card mt-6 p-6">
        <h2 class="text-lg font-bold">رزرو نوبت با {therapist.data.name}</h2>
        <div class="mt-4">
          <ContactChannels compact />
        </div>
      </div>
    </div>
  </section>
  <section class="container-site pb-20">
    <article class="prose-fa mx-auto">
      <Content />
    </article>
  </section>
</BaseLayout>
