---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import TherapistCard from "../../components/cards/TherapistCard.astro";
import { issueTopics, issuesFor } from "../../utils/issues";
import { toPersianDigits } from "../../utils/persian";

const therapists = (await getCollection("therapists")).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order,
);
const withIssues = therapists.map((t) => ({ therapist: t, issues: issuesFor(t.data.specialties) }));
---
<BaseLayout
  title="روانشناسان کلینیک پندار نیم‌رخ قم"
  description="روانشناسان و درمانگران کلینیک پندار نیم‌رخ قم؛ با حوزه‌های کاری مشخص در روان‌درمانی فردی، زوج‌درمانی، خانواده و کودک و نوجوان."
>
  <PageHeader
    title="روانشناسان کلینیک پندار نیم‌رخ قم"
    breadcrumbs={[{ label: "خانه", href: "/" }, { label: "درمانگران" }]}
    intro="هر درمانگر حوزه کاری و رویکرد خودش را دارد. موضوع خود را انتخاب کنید تا ببینید چه کسی در آن زمینه کار می‌کند؛ بعد پروفایل را بخوانید و اگر تردید داشتید، در فرم درخواست نوبت بنویسید تا راهنمایی شوید."
  />
  <section class="container-site section">
    <div class="mb-8">
      <h2 class="text-sm font-bold text-ink-muted">برای چه موضوعی کمک می‌خواهید؟</h2>
      <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="فیلتر درمانگران بر اساس موضوع">
        <button
          type="button"
          data-issue-filter=""
          data-hint=""
          aria-pressed="true"
          class="rounded-full border border-primary-700 bg-primary-700 px-3.5 py-1.5 text-sm font-medium text-white transition-colors"
        >
          همه
        </button>
        {issueTopics.map((topic) => (
          <button
            type="button"
            data-issue-filter={topic.id}
            data-hint={topic.hint}
            aria-pressed="false"
            class="rounded-full border border-primary-200 bg-surface px-3.5 py-1.5 text-sm font-medium text-ink transition-colors hover:border-primary-400 hover:text-primary-700 aria-pressed:border-primary-700 aria-pressed:bg-primary-700 aria-pressed:text-white"
          >
            {topic.label}
          </button>
        ))}
      </div>
      <p data-issue-hint class="mt-3 text-sm leading-6 text-ink-muted">
        یکی از موضوع‌ها را انتخاب کنید؛ فقط درمانگرانی که همان حوزه را کار می‌کنند نمایش داده می‌شوند.
      </p>
      <p class="mt-1 text-sm font-semibold text-primary-700" aria-live="polite">
        <span data-therapist-count>{toPersianDigits(therapists.length)}</span> درمانگر
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {withIssues.map(({ therapist: t, issues }, i) => (
        <TherapistCard
          id={t.id}
          name={t.data.name}
          title={t.data.title}
          specialties={t.data.specialties}
          issues={issues}
          online={t.data.online}
          headingLevel="h2"
          priority={i < 3}
        />
      ))}
    </div>

    <p data-therapist-empty class="card mt-2 hidden p-6 text-center text-ink-muted">
      برای این موضوع هنوز درمانگری در فهرست نیست. با کلینیک تماس بگیرید تا متناسب با نیاز شما راهنمایی شویم.
      <a href="/contact/#booking" class="mt-3 block font-semibold text-primary-700 underline underline-offset-4">درخواست نوبت</a>
    </p>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-issue-filter]");
  const cards = [...document.querySelectorAll<HTMLElement>("[data-therapist-card]")];
  const count = document.querySelector<HTMLElement>("[data-therapist-count]");
  const empty = document.querySelector<HTMLElement>("[data-therapist-empty]");
  const hint = document.querySelector<HTMLElement>("[data-issue-hint]");
  const defaultHint = hint?.textContent?.trim() ?? "";
  const FA_DIGITS = "۰۱۲۳۴۵۶۷۸۹";

  const apply = (issue: string) => {
    let visible = 0;
    for (const card of cards) {
      const issues = (card.dataset.issues ?? "").split(" ");
      const show = !issue || issues.includes(issue);
      card.classList.toggle("hidden", !show);
      if (show) visible += 1;
    }
    if (count) {
      count.textContent = String(visible).replace(/\d/g, (d) => FA_DIGITS[Number(d)]);
    }
    empty?.classList.toggle("hidden", visible > 0);
  };

  const allButton = [...buttons].find((b) => !b.dataset.issueFilter) ?? buttons[0];

  for (const button of buttons) {
    button.addEventListener("click", () => {
      const wasActive = button.getAttribute("aria-pressed") === "true";
      const active = wasActive ? allButton : button;
      for (const other of buttons) {
        other.setAttribute("aria-pressed", String(other === active));
      }
      if (hint) hint.textContent = active.dataset.hint || defaultHint;
      apply(active.dataset.issueFilter ?? "");
    });
  }
</script>
