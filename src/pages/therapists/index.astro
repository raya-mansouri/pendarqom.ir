---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TherapistCard from "../../components/cards/TherapistCard.astro";

const therapists = (await getCollection("therapists")).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order,
);
---
<BaseLayout
  title="روانشناسان کلینیک پندار نیم‌رخ قم"
  description="روانشناسان و درمانگران کلینیک پندار نیم‌رخ قم؛ متخصصان دارای پروانه در حوزه‌های روان‌درمانی فردی، زوج‌درمانی، خانواده و کودک و نوجوان."
>
  <div class="container-site pt-10">
    <h1 class="text-3xl sm:text-4xl">روانشناسان کلینیک پندار نیم‌رخ قم</h1>
    <p class="mt-3 max-w-2xl text-ink-muted">همه درمانگران ما دارای پروانه فعالیت معتبر هستند.</p>
  </div>
  <section class="container-site section">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {therapists.map((t, i) => (
        <TherapistCard
          id={t.id}
          name={t.data.name}
          title={t.data.title}
          specialties={t.data.specialties}
          headingLevel="h2"
          priority={i < 3}
        />
      ))}
    </div>
  </section>
</BaseLayout>
