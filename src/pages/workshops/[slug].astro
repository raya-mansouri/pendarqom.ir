---
import { getCollection, render } from "astro:content";
import { Picture } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../data/site";
import { whatsappLink, instagramDmLink, workshopSignupMessage, telHref } from "../../utils/links";
import { workshopPosters } from "../../utils/assets";
import { toPersianDigits } from "../../utils/persian";

export async function getStaticPaths() {
  const workshops = await getCollection("workshops");
  return workshops.map((workshop) => ({
    params: { slug: workshop.id },
    props: { workshop },
  }));
}
const { workshop } = Astro.props;
const { Content } = await render(workshop);
const poster = workshopPosters[workshop.id];
const isPast = workshop.data.status === "past";
const signupHref =
  workshop.data.status === "open" && site.whatsapp
    ? whatsappLink(site.whatsapp, workshopSignupMessage(workshop.data.title))
    : undefined;
const instagramHref =
  workshop.data.status === "open" && site.instagram ? instagramDmLink(site.instagram) : undefined;
const dateParts = [workshop.data.dateDisplay, workshop.data.time].filter(Boolean);
---
<BaseLayout
  title={`${workshop.data.title} | کارگاه‌های پندار نیم‌رخ`}
  description={`کارگاه «${workshop.data.title}» با مدرسی ${workshop.data.instructor}${workshop.data.dateDisplay ? ` — ${workshop.data.dateDisplay}` : ""}، ${workshop.data.location}`}
  ogImage={poster?.src}
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "خانه", item: site.url },
        { "@type": "ListItem", position: 2, name: "کارگاه‌ها", item: `${site.url}/workshops/` },
        { "@type": "ListItem", position: 3, name: workshop.data.title },
      ],
    },
    {
      "@context": "https://schema.org",
      "@type": "Event",
      name: workshop.data.title,
      startDate: workshop.data.startDate?.toISOString().slice(0, 10),
      eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
      eventStatus: isPast ? undefined : "https://schema.org/EventScheduled",
      location: { "@type": "Place", name: workshop.data.location, address: site.address },
      image: poster ? new URL(poster.src, site.url).href : undefined,
      description: `کارگاه «${workshop.data.title}» با مدرسی ${workshop.data.instructor}`,
      organizer: { "@type": "Organization", name: site.name, url: site.url },
      performer: { "@type": "Person", name: workshop.data.instructor },
    },
  ]}
>
  <div class="container-site pt-10">
    <Breadcrumbs items={[{ label: "خانه", href: "/" }, { label: "کارگاه‌ها", href: "/workshops/" }, { label: workshop.data.title }]} />
    <div class="mt-6 max-w-3xl">
      <div class="flex flex-wrap items-center gap-3">
        <StatusBadge status={workshop.data.status} />
        {dateParts.length > 0 && (
          <span class="inline-flex items-center gap-1.5 text-sm text-ink-muted">
            <Icon name="calendar" size={16} /> {dateParts.join(" · ")}
          </span>
        )}
      </div>
      <h1 class="mt-3 text-3xl sm:text-4xl">{workshop.data.title}</h1>
      <p class="mt-3 text-ink-muted">مدرس: {workshop.data.instructor}</p>
    </div>
  </div>
  <section class="container-site section grid gap-10 lg:grid-cols-[1fr_340px]">
    <article class="prose-fa">
      <Content />
    </article>
    <aside class="card h-fit p-6">
      {poster && (
        <Picture
          src={poster}
          alt={`پوستر کارگاه ${workshop.data.title}`}
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[340, 480, 680, 820, 960, 1024].filter((w) => w < poster.width).concat(poster.width)}
          sizes="(min-width: 64rem) calc(340px - 3rem), (min-width: 40rem) calc(100vw - 6rem), calc(100vw - 5rem)"
          quality={82}
          loading="lazy"
          decoding="async"
          class="mb-6 w-full rounded-xl bg-surface object-contain"
        />
      )}
      <h2 class="text-lg font-bold">مشخصات کارگاه</h2>
      <dl class="mt-4 space-y-3 text-sm">
        {dateParts.length > 0 && (
          <div class="flex justify-between gap-4"><dt class="text-ink-muted">زمان</dt><dd>{dateParts.join("، ")}</dd></div>
        )}
        {workshop.data.sessions && (
          <div class="flex justify-between gap-4"><dt class="text-ink-muted">تعداد جلسات</dt><dd>{toPersianDigits(workshop.data.sessions)} جلسه</dd></div>
        )}
        {workshop.data.audience && (
          <div class="flex justify-between gap-4"><dt class="text-ink-muted">مخاطب</dt><dd>{workshop.data.audience}</dd></div>
        )}
        <div class="flex justify-between gap-4"><dt class="text-ink-muted">مکان</dt><dd>{workshop.data.location}</dd></div>
        {workshop.data.capacity && (
          <div class="flex justify-between gap-4"><dt class="text-ink-muted">ظرفیت</dt><dd>{toPersianDigits(workshop.data.capacity)} نفر</dd></div>
        )}
        {workshop.data.fee && (
          <div class="flex justify-between gap-4"><dt class="text-ink-muted">شهریه</dt><dd class="font-semibold">{workshop.data.fee}</dd></div>
        )}
      </dl>
      <div class="mt-6 space-y-3">
        {workshop.data.status === "open" ? (
          <>
            {signupHref && (
              <a href={signupHref} target="_blank" rel="noopener" class="btn btn-whatsapp w-full">ثبت‌نام با واتساپ</a>
            )}
            {instagramHref && (
              <a href={instagramHref} target="_blank" rel="noopener" class="btn btn-secondary w-full">
                <Icon name="instagram" size={18} /> ثبت‌نام در دایرکت اینستاگرام
              </a>
            )}
          </>
        ) : isPast ? (
          <p class="rounded-xl bg-status-past-bg px-4 py-3 text-center text-sm font-semibold text-status-past">این کارگاه برگزار شده است.</p>
        ) : (
          <p class="rounded-xl bg-status-full-bg px-4 py-3 text-center text-sm font-semibold text-status-full">ظرفیت این کارگاه تکمیل شده است.</p>
        )}
        <a href={telHref(site.phones[0].number)} class="btn btn-call w-full">
          <Icon name="phone" size={18} /> تماس با کلینیک
        </a>
        {workshop.data.registrationNote && (
          <p class="text-xs leading-6 text-ink-muted">{workshop.data.registrationNote}</p>
        )}
      </div>
    </aside>
  </section>
</BaseLayout>
